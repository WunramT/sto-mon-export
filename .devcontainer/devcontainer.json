{
  "name": "basis-bom",
  "dockerComposeFile": "docker-compose.yml",
  "service": "dev",
  "workspaceFolder": "/workspaces/ML_Server",
  "shutdownAction": "stopCompose",
  "forwardPorts": [
    8888,
    8000,
    3000,
    "db:5432"
  ],
  "postCreateCommand": "sudo apt-get update -qq && sudo apt-get install -y -qq postgresql-client && pip install -e \".[dev]\" -r backend/requirements.txt && python -m ipykernel install --user --name basis-bom && basis-bom db init --fixtures --nur-wenn-leer && (cd frontend && npm ci)",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-keymap",
        "charliermarsh.ruff",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg",
        "congyiwu.vscode-jupytext"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "jupyter.notebookFileRoot": "${workspaceFolder}",
        "jupyter.defaultKernel": "basis-bom",
        "sqltools.connections": [
          {
            "name": "basis (dev)",
            "driver": "PostgreSQL",
            "server": "db",
            "port": 5432,
            "database": "basis",
            "username": "basis",
            "password": "basis"
          }
        ]
      }
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  }
}
