# Vorlage für $HOME/deployment/konfig-stueckliste-export_<env>/base/sens.env auf dem Zielhost.
# NICHT ins Repo mit echten Werten. DATABASE_HOST und DATABASE_NAME setzt das Jenkinsfile je Umgebung.

# Signatur der Anmelde-Tokens (mind. 32 Zeichen, z. B. `openssl rand -hex 32`)
SECRET_KEY=bitte-ersetzen-durch-openssl-rand-hex-32-xxxxxxxxxxxxxxxx
# Gemeinsames Team-Passwort für den Prototyp (alle haben alle Rechte)
MASTER_PASSWORD_ADMIN=bitte-ersetzen

# Zugang zum gemeinsamen Postgres-Container (postgres_db_dev / postgres_db_prod).
# Empfohlen: eigene Rolle nur für diese App (docs/DEPLOYMENT.md), nicht der Superuser postgres.
DATABASE_USER=konfig_stueckliste_export
DATABASE_PASSWORD=bitte-ersetzen
DATABASE_PORT=5432

# Optional
# ACCESS_TOKEN_EXPIRE_MINUTES=720        # Anmeldung gilt einen Arbeitstag
# DEMO_FIXTURES=F                        # T: ohne Exporte synthetische Beispieldaten laden (nur Test)
# BASIS_BOM_MODE=prod                    # abweichende Export-Stichtage sind dann Fehler statt Warnung (D14)
